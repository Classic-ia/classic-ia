{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "classiccouros.com.br" }],
      "destination": "https://app.classiccouros.com.br/$1",
      "permanent": true
    },
    {
      "source": "/rhesst/:path*",
      "destination": "/rh/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/rh/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/rh/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
