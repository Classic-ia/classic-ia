{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "classiccouros.com.br" }],
      "destination": "https://app.classiccouros.com.br/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rhesst/:path*",
      "destination": "https://classic-rh.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/rhesst/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
