# ============================================================================
# CONFIGURACAO COMPARTILHADA - Credenciais do Renomeador RH PRO
# ============================================================================
#
# COMO USAR:
# 1. Renomeie este arquivo para ".env" (remova ".exemplo")
# 2. Cole as suas chaves/token abaixo (sem aspas, sem espacos)
# 3. Salve. Ao abrir o programa, os campos sao preenchidos sozinhos.
#
# Se colocar o .env numa pasta sincronizada no OneDrive, todas as
# maquinas da equipe usam as mesmas credenciais.
# ============================================================================

# Chave da API Google Gemini (gratis em: https://aistudio.google.com/apikey)
GEMINI_KEY=COLE_AQUI_SUA_CHAVE_GEMINI

# Chave da API Anthropic Claude - opcional (https://console.anthropic.com/keys)
CLAUDE_KEY=

# Token da API Convenia (Painel Convenia > Integracoes > API > Tokens)
CONVENIA_TOKEN=COLE_AQUI_SEU_TOKEN_CONVENIA

# ============================================================================
# SEGURANCA:
# - NUNCA versione o arquivo ".env" no Git (ja esta no .gitignore).
# - NUNCA compartilhe estas credenciais fora da equipe autorizada.
# ============================================================================
